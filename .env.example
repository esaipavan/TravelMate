# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Required
# Get from: Supabase Dashboard → Settings → API
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# App config
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_NAME=TravelMate
VITE_APP_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# Geoapify Places API — Required for Nearby Places feature
# Free key: https://myprojects.geoapify.com → New Project → API Key
# Free tier: 3,000 req/day. Domain-restrict in the Geoapify console.
# ─────────────────────────────────────────────────────────────────────────────
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key

# ─────────────────────────────────────────────────────────────────────────────
# AI provider label — frontend display ONLY, does not affect routing.
# Options: groq | gemini | openrouter
# ─────────────────────────────────────────────────────────────────────────────
VITE_AI_PROVIDER=groq

# ─────────────────────────────────────────────────────────────────────────────
# Analytics — all optional; omit to disable each provider
# ─────────────────────────────────────────────────────────────────────────────

# Google Analytics 4
# Get from: analytics.google.com → Admin → Data Streams → Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# Microsoft Clarity (heatmaps & session recordings)
# Get from: clarity.microsoft.com → New project → Project ID
VITE_CLARITY_PROJECT_ID=

# PostHog (product analytics — requires: npm i posthog-js)
# Get from: app.posthog.com → Project Settings → Project API Key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────────────────────────────────────
# SEO — Google Search Console
# Paste your verification code from: search.google.com/search-console
# Then add <meta name="google-site-verification" content="..." /> to index.html
# ─────────────────────────────────────────────────────────────────────────────
# VITE_GSC_VERIFICATION=your-verification-code

# ─────────────────────────────────────────────────────────────────────────────
# Server-side secrets — set via: supabase secrets set KEY=VALUE
# NEVER stored here or in any frontend file.
#
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-...
# ─────────────────────────────────────────────────────────────────────────────
